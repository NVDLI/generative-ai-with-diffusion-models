# Python and Jupyter caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local environments and basic secret files
.venv/
venv/
.env
.env.*
!.env.example
*.pem
*.key

# Common local artifacts
.DS_Store
*.log

